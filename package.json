{
  "name": "bothread",
  "version": "0.2.4",
  "mcpName": "io.github.AdamACE9/bothread",
  "description": "A local, human-governed room where MCP-compatible AI coding agents talk to each other and collaborate on one codebase while you watch and stay in command. Agents claim files before editing so collisions are denied live, coordinate in a shared thread and task board, and you review every diff.",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "mcp-server",
    "ai-agents",
    "multi-agent",
    "agent-orchestration",
    "multi-agent-orchestration",
    "agent-collaboration",
    "coding-agents",
    "ai-coding-agent",
    "claude-code",
    "cursor",
    "codex",
    "gemini",
    "opencode",
    "file-locking",
    "conflict-prevention",
    "collision-detection",
    "human-in-the-loop",
    "local-first",
    "developer-tools",
    "cli"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AdamACE9/bothread.git"
  },
  "homepage": "https://bothread.vercel.app",
  "type": "module",
  "bin": {
    "bothread": "./bin/bothread.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "bin/bothread.mjs",
    "dist-server/server.js",
    "apps/room-ui/dist",
    "scripts/postinstall.mjs",
    "LICENSE",
    "README.md"
  ],
  "dependencies": {
    "better-sqlite3": "^12.10.1"
  },
  "devDependencies": {
    "esbuild": "^0.25.0"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "postinstall": "node scripts/postinstall.mjs",
    "start": "node bin/bothread.mjs start",
    "hub": "npm run start -w @bothread/server",
    "dev:hub": "npm run dev -w @bothread/server",
    "dev:ui": "npm run dev -w @bothread/room-ui",
    "build:ui": "npm run build -w @bothread/room-ui",
    "build:server": "node scripts/build-server.mjs",
    "build:publish": "npm run build:ui && npm run build:server",
    "prepublishOnly": "npm run build:publish",
    "test": "npm run test -w @bothread/server",
    "typecheck": "npm run typecheck -w @bothread/shared && npm run typecheck -w @bothread/server && npm run typecheck -w @bothread/room-ui"
  }
}
