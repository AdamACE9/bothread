rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    match /waitlist/{emailId} {
      allow read, list: if false;
      allow delete: if false;
      allow create, update: if isValidWaitlist();
    }

    match /feedback/{docId} {
      allow read, list: if false;
      allow update, delete: if false;
      allow create: if isValidFeedback();
    }

    // Anonymous CLI usage counters. Write-only from outside — nobody but the
    // admin dashboard's server-side (Admin SDK, bypasses these rules) reads it.
    match /telemetry/{docId} {
      allow read, list, update, delete: if false;
      allow create: if isValidTelemetry();
    }

    match /{document=**} {
      allow read, write: if false;
    }

    function isValidWaitlist() {
      let d = request.resource.data;
      return d.keys().hasAll(['email', 'source', 'createdAt'])
        && d.keys().hasOnly(['email', 'source', 'createdAt', 'userAgent'])
        && d.email is string
        && d.email.size() >= 5 && d.email.size() <= 254
        && d.email.matches('^[^@\\s]+@[^@\\s]+[.][^@\\s]+$')
        && d.source is string
        && d.source in ['hero', 'waitlist', 'footer']
        && d.createdAt == request.time
        && (!('userAgent' in d) || (d.userAgent is string && d.userAgent.size() <= 512));
    }

    function isValidFeedback() {
      let d = request.resource.data;
      return d.keys().hasAll(['category', 'message', 'createdAt'])
        && d.keys().hasOnly(['category', 'message', 'email', 'createdAt', 'userAgent', 'page'])
        && d.category is string
        && d.category in ['bug', 'feature', 'general', 'other']
        && d.message is string
        && d.message.size() >= 1 && d.message.size() <= 4000
        && d.createdAt == request.time
        && (!('email' in d) || d.email == null ||
            (d.email is string && d.email.size() >= 5 && d.email.size() <= 254
             && d.email.matches('^[^@\\s]+@[^@\\s]+[.][^@\\s]+$')))
        && (!('userAgent' in d) || (d.userAgent is string && d.userAgent.size() <= 512))
        && (!('page' in d) || (d.page is string && d.page.size() <= 200));
    }

    function isValidTelemetry() {
      let d = request.resource.data;
      return d.keys().hasAll(['event', 'platform', 'ts'])
        && d.keys().hasOnly(['event', 'platform', 'ts', 'channel', 'version', 'ci'])
        && d.event is string
        && d.event in ['package_installed', 'bothread_start', 'room_created']
        && d.platform is string
        && d.platform in ['windows', 'mac', 'linux', 'other']
        && d.ts is timestamp
        && (!('channel' in d) || (d.channel is string && d.channel in ['npx', 'global', 'dev-clone', 'local', 'other']))
        && (!('version' in d) || (d.version is string && d.version.size() <= 40))
        && (!('ci' in d) || d.ci is bool);
    }
  }
}
